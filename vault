#!/usr/bin/env bash
# ==============================================================================
# Sovereign Practice Vault CLI Launcher
# Heath & City Practice Vault
# ==============================================================================

# Delegate directly to the active Practice Vault installation if present
if [[ -x "/home/neville/practice-vault/vault" ]]; then
  exec /home/neville/practice-vault/vault "$@"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_HOME="/home/neville/practice-vault"
PYTHON_EXEC="${VAULT_HOME}/venv/bin/python"
CLI_SCRIPT="${VAULT_HOME}/scripts/vault_cli.py"

if [[ ! -x "${PYTHON_EXEC}" ]]; then
  PYTHON_EXEC="python3"
fi

exec "${PYTHON_EXEC}" "${CLI_SCRIPT}" "$@"
